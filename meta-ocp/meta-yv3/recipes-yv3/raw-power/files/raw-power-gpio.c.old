#include <stdio.h>
#include <gpiod.h>
#include <stdlib.h>
#include <string.h>
#include <errno.h>

#include "raw-power-gpio.h"

#define CONSUMER "Consumer"

//static char* path = (char*)"/sys/class/gpio/gpiochip792";
static char* path = (char*)"/dev/gpiochip0";

/* Request a line as input. */
static struct gpiod_line_request *request_input_line(const char *chip_path,
						     unsigned int offset,
						     const char *consumer)
{
	struct gpiod_request_config *req_cfg = NULL;
	struct gpiod_line_request *request = NULL;
	struct gpiod_line_settings *settings;
	struct gpiod_line_config *line_cfg;
	struct gpiod_chip *chip;
	int ret;

	chip = gpiod_chip_open(chip_path);
	if (!chip)
		return NULL;

	settings = gpiod_line_settings_new();
	if (!settings)
		goto close_chip;

	gpiod_line_settings_set_direction(settings, GPIOD_LINE_DIRECTION_INPUT);

	line_cfg = gpiod_line_config_new();
	if (!line_cfg)
		goto free_settings;

	ret = gpiod_line_config_add_line_settings(line_cfg, &offset, 1,
						  settings);
	if (ret)
		goto free_line_config;

	if (consumer) {
		req_cfg = gpiod_request_config_new();
		if (!req_cfg)
			goto free_line_config;

		gpiod_request_config_set_consumer(req_cfg, consumer);
	}

	request = gpiod_chip_request_lines(chip, req_cfg, line_cfg);

	gpiod_request_config_free(req_cfg);

free_line_config:
	gpiod_line_config_free(line_cfg);

free_settings:
	gpiod_line_settings_free(settings);

close_chip:
	gpiod_chip_close(chip);

	return request;
}

static struct gpiod_line_request *
request_output_line(const char *chip_path, unsigned int offset,
		    enum gpiod_line_value value, const char *consumer)
{
	struct gpiod_request_config *req_cfg = NULL;
	struct gpiod_line_request *request = NULL;
	struct gpiod_line_settings *settings;
	struct gpiod_line_config *line_cfg;
	struct gpiod_chip *chip;
	int ret;

	chip = gpiod_chip_open(chip_path);
	if (!chip)
		return NULL;

	settings = gpiod_line_settings_new();
	if (!settings)
		goto close_chip;

	gpiod_line_settings_set_direction(settings,
					  GPIOD_LINE_DIRECTION_OUTPUT);
	gpiod_line_settings_set_output_value(settings, value);

	line_cfg = gpiod_line_config_new();
	if (!line_cfg)
		goto free_settings;

	ret = gpiod_line_config_add_line_settings(line_cfg, &offset, 1,
						  settings);
	if (ret)
		goto free_line_config;

	if (consumer) {
		req_cfg = gpiod_request_config_new();
		if (!req_cfg)
			goto free_line_config;

		gpiod_request_config_set_consumer(req_cfg, consumer);
	}

	request = gpiod_chip_request_lines(chip, req_cfg, line_cfg);

	gpiod_request_config_free(req_cfg);

free_line_config:
	gpiod_line_config_free(line_cfg);

free_settings:
	gpiod_line_settings_free(settings);

close_chip:
	gpiod_chip_close(chip);

	return request;
}

// returns >= 0 on success
// returns -1 on fail
int gpio_line_offset_by_name(char* line_name){

	struct gpiod_chip* chip = gpiod_chip_open(path);
	if (!chip)
		return -1;

	int offset = gpiod_chip_get_line_offset_from_name(chip, line_name);
	if (offset == -1)
		goto close_chip;

	return offset;

close_chip:
	gpiod_chip_close(chip);
	return -1;
}

// returns 0
// returns < 0 on error
int gpio_set_by_name(char* name, int value1){

	int offset = gpio_line_offset_by_name(name);
	if (offset < 0)
		return -1;

	enum gpiod_line_value value = (value1 == 1) ? GPIOD_LINE_VALUE_ACTIVE: GPIOD_LINE_VALUE_INACTIVE;
	struct gpiod_line_request *request;

	request = request_output_line(path, offset, value,
				      "line-value");
	if (!request) {
		fprintf(stderr, "failed to request line: %s\n",
			strerror(errno));
		return EXIT_FAILURE;
	}

	gpiod_line_request_set_value(request, offset, value);

	gpiod_line_request_release(request);

	return 0;
}

// returns 0,1
// returns < 0 on error
int gpio_read_by_name(char *name) {

	int offset = gpio_line_offset_by_name(name);
	if (offset < 0)
		return -1;

	struct gpiod_line_request *request;
	enum gpiod_line_value value;

	request = request_input_line(path, offset, "get-line-value");
	if (!request) {
		fprintf(stderr, "failed to request line: %s\n",
			strerror(errno));
		return -1;
	}

	value = gpiod_line_request_get_value(request, offset);

	/* not strictly required here, but if the app wasn't exiting... */
	gpiod_line_request_release(request);

	return value;
}

