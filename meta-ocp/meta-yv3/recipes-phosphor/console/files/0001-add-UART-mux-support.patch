diff --git a/console-ctl.c b/console-ctl.c
new file mode 100644
index 0000000..d458eff
--- /dev/null
+++ b/console-ctl.c
@@ -0,0 +1,132 @@
+#include <err.h>
+#include <getopt.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <systemd/sd-bus.h>
+
+#include "call-mapper.h"
+
+static const struct option options[] = {
+	{ "activate", no_argument, 0, 'a' },
+	{ "console-id", required_argument, 0, 'i' },
+	{ 0, 0, 0, 0 },
+};
+
+static void usage(const char *progname)
+{
+	fprintf(stderr,
+		"usage: %s --activate --console-id <NAME> \n"
+		"\n"
+		"Options:\n"
+		"  --activate \tActivate the console specified by --console-id\n"
+		"  --console-id <NAME>\tSelect a console\n"
+		"",
+		progname);
+}
+
+static int call_activate(char* dbus_name, char* dbus_path, bool arg){
+
+	printf("DEBUG: call_activate\n");
+	
+	char* dbus_interface = "xyz.openbmc_project.Console.Control";
+	
+	struct sd_bus *bus;
+	int r;
+
+	r = sd_bus_default_system(&bus);
+	if (r < 0) {
+		warnx("Failed to connect to system bus: %s", strerror(-r));
+		return EXIT_FAILURE;
+	}
+
+	sd_bus_error err;
+	sd_bus_message *reply = NULL;
+	int status = sd_bus_call_method(bus, dbus_name, dbus_path, dbus_interface, 
+		"Activate", &err, &reply, "b", arg);
+
+	if(status < 0){
+		warnx("dbus call 'Activate(%d)' failed", arg);
+		return EXIT_FAILURE;
+	}
+
+	int reply_status;
+	status = sd_bus_message_read(reply, "i", &reply_status);
+
+	if(status < 0){
+		warnx("dbus call 'Activate(%d)': could not read from response", arg);
+		return EXIT_FAILURE;
+	}
+
+	printf("debug: reply status: %d\n", reply_status);
+
+	return reply_status;
+}
+
+static int console_ctl(char* console_id){
+
+	const size_t dbus_obj_path_len = 1024;
+	char dbus_name_active_console[dbus_obj_path_len];
+	char dbus_path_active_console[dbus_obj_path_len];
+	char* dbus_interface = "xyz.openbmc_project.Console.Control";
+	
+	struct sd_bus *bus;
+	int r;
+	sprintf(dbus_name_active_console, "xyz.openbmc_project.Console.%s", console_id);
+	sprintf(dbus_path_active_console, "/xyz/openbmc_project/console/%s", console_id);
+
+	r = sd_bus_default_system(&bus);
+	if (r < 0) {
+		warnx("Failed to connect to system bus: %s", strerror(-r));
+		return EXIT_FAILURE;
+	}
+
+	//TODO: get the 'Device' property of that dbus id.
+
+	//TODO: query all dbus service with that 'Device' via objectmapper
+	call_objectmapper_getsubtree(dbus_interface);
+
+	//TODO: call Activate(false) on all these dbus objects
+
+	//TODO: call Activate(true) on our dbus object
+	int status;
+
+	status = call_activate(dbus_name_active_console, dbus_path_active_console, true);
+	
+	return status;
+}
+
+int main(int argc, char **argv)
+{
+	char *console_id = NULL;
+	bool activate = false;
+	for (;;) {
+		int c;
+		int idx;
+
+		c = getopt_long(argc, argv, "i:", options, &idx);
+		if (c == -1) {
+			break;
+		}
+
+		switch (c) {
+		case 'a':
+			activate = true;
+			break;
+		case 'i':
+			console_id = optarg;
+			break;
+		case 'h':
+		case '?':
+			usage(argv[0]);
+			return EXIT_SUCCESS;
+		}
+	}
+
+	if(!activate){
+		usage(argv[0]);
+		return EXIT_FAILURE;
+	}
+
+	return console_ctl(console_id);
+}
