/dts-v1/;

#include "aspeed-g6.dtsi"
#include <dt-bindings/gpio/aspeed-gpio.h>
#include <dt-bindings/i2c/i2c.h>

/ {
    model = "ASRock TURIN2D24TM3-2L BMC";
    compatible = "asrock,turin2d24tm3-2l-bmc", "aspeed,ast2600";

    aliases {
        // bus 1
        i2c20 = &BMC_SMB1;
        i2c21 = &BMC_SMB2;
        i2c22 = &BMC_SMB3;
        i2c23 = &MCIO5_1;
        i2c24 = &MCIO5_2;
        i2c25 = &MCIO6_1;
        i2c26 = &MCIO6_2;

        // bus 10
        i2c27 = &PCIE_SLOT1;
        i2c28 = &PCIE_SLOT2;
        i2c29 = &PCIE_SLOT3;
        i2c30 = &M2_SLOT1;
        i2c31 = &MCIO8_1;
        i2c32 = &MCIO8_2;
        i2c33 = &M2_SLOT2;
        i2c34 = &OCP_SLOT1;
    };

    chosen {
        stdout-path = &uart5;
        bootargs = "console=ttyS4,115200 earlycon";
    };

    memory@80000000 {
        device_type = "memory";
        reg = <0x80000000 0x20000000>;
    };

    reserved-memory {
        #address-cells = <1>;
        #size-cells = <1>;
        ranges;

        video_engine_memory: video {
            size = <0x2000000>;
            alignment = <0x1000000>;
            compatible = "shared-dma-pool";
            reusable;
        };

        gfx_memory: framebuffer {
            size = <0x2000000>;
            alignment = <0x1000000>;
            compatible = "shared-dma-pool";
            reusable;
        };
    };

    iio-hwmon {
        compatible = "iio-hwmon";
        io-channels = <&adc0 0>, <&adc0 1>, <&adc0 2>, <&adc0 3>,
            <&adc0 4>, <&adc0 5>, <&adc0 6>, <&adc0 7>,
            <&adc1 0>, <&adc1 1>, <&adc1 2>, <&adc1 3>,
            <&adc1 4>, <&adc1 5>, <&adc1 6>, <&adc1 7>;
    };

    leds {
        compatible = "gpio-leds";

        BMC_HB_LED {
            gpios = <&gpio0 ASPEED_GPIO(P, 7) GPIO_ACTIVE_LOW>;
            linux,default-trigger = "heartbeat";
        };

        BMC_ID_LED {
            gpios = <&gpio0 ASPEED_GPIO(F, 5) GPIO_ACTIVE_LOW>;
            default-state = "off";
        };

        BMC_SYS_FAULT_LED {
            gpios = <&gpio0 ASPEED_GPIO(G, 0) GPIO_ACTIVE_LOW>;
            default-state = "off";
        };
    };

    fan0: pwm-fan0 {
        compatible = "pwm-fan";
        pwms = <&pwm_tach 0 40000 0>;
        cooling-min-state = <0>;
        cooling-max-state = <3>;
        #cooling-cells = <2>;
        cooling-levels = <0 64 128 192 255>;
    };

    fan1: pwm-fan1 {
        compatible = "pwm-fan";
        pwms = <&pwm_tach 1 40000 0>;
        cooling-min-state = <0>;
        cooling-max-state = <3>;
        #cooling-cells = <2>;
        cooling-levels = <0 64 128 192 255>;
    };

    fan2: pwm-fan2 {
        compatible = "pwm-fan";
        pwms = <&pwm_tach 2 40000 0>;
        cooling-min-state = <0>;
        cooling-max-state = <3>;
        #cooling-cells = <2>;
        cooling-levels = <0 64 128 192 255>;
    };

    fan3: pwm-fan3 {
        compatible = "pwm-fan";
        pwms = <&pwm_tach 3 40000 0>;
        cooling-min-state = <0>;
        cooling-max-state = <3>;
        #cooling-cells = <2>;
        cooling-levels = <0 64 128 192 255>;
    };

    fan4: pwm-fan4 {
        compatible = "pwm-fan";
        pwms = <&pwm_tach 4 40000 0>;
        cooling-min-state = <0>;
        cooling-max-state = <3>;
        #cooling-cells = <2>;
        cooling-levels = <0 64 128 192 255>;
    };

    fan5: pwm-fan5 {
        compatible = "pwm-fan";
        pwms = <&pwm_tach 5 40000 0>;
        cooling-min-state = <0>;
        cooling-max-state = <3>;
        #cooling-cells = <2>;
        cooling-levels = <0 64 128 192 255>;
    };

    fan6: pwm-fan6 {
        compatible = "pwm-fan";
        pwms = <&pwm_tach 6 40000 0>;
        cooling-min-state = <0>;
        cooling-max-state = <3>;
        #cooling-cells = <2>;
        cooling-levels = <0 64 128 192 255>;
    };

    fan7: pwm-fan7 {
        compatible = "pwm-fan";
        pwms = <&pwm_tach 7 40000 0>;
        cooling-min-state = <0>;
        cooling-max-state = <3>;
        #cooling-cells = <2>;
        cooling-levels = <0 64 128 192 255>;
    };

    /* I3C Controllers for DDR5 DIMM SPD/Temperature Sensors */
    i3c_global: i3c-global@1e7a0000 {
        compatible = "aspeed,ast2600-i3c-global", "syscon";
        reg = <0x1e7a0000 0x1000>;
        resets = <&syscon ASPEED_RESET_I3C>;
        #address-cells = <1>;
        #size-cells = <0>;
    };

    i3c0: i3c@1e7a2000 {
        compatible = "aspeed,ast2600-i3c";
        reg = <0x1e7a2000 0x1000>;
        #address-cells = <3>;
        #size-cells = <0>;
        #interrupt-cells = <1>;
        clocks = <&syscon ASPEED_CLK_GATE_I3C0CLK>;
        resets = <&syscon ASPEED_RESET_I3C0>;
        interrupts = <GIC_SPI 102 IRQ_TYPE_LEVEL_HIGH>;
        status = "disabled";
    };

    i3c1: i3c@1e7a3000 {
        compatible = "aspeed,ast2600-i3c";
        reg = <0x1e7a3000 0x1000>;
        #address-cells = <3>;
        #size-cells = <0>;
        #interrupt-cells = <1>;
        clocks = <&syscon ASPEED_CLK_GATE_I3C1CLK>;
        resets = <&syscon ASPEED_RESET_I3C1>;
        interrupts = <GIC_SPI 103 IRQ_TYPE_LEVEL_HIGH>;
        status = "disabled";
    };

    i3c2: i3c@1e7a4000 {
        compatible = "aspeed,ast2600-i3c";
        reg = <0x1e7a4000 0x1000>;
        #address-cells = <3>;
        #size-cells = <0>;
        #interrupt-cells = <1>;
        clocks = <&syscon ASPEED_CLK_GATE_I3C2CLK>;
        resets = <&syscon ASPEED_RESET_I3C2>;
        interrupts = <GIC_SPI 104 IRQ_TYPE_LEVEL_HIGH>;
        status = "disabled";
    };

    i3c3: i3c@1e7a5000 {
        compatible = "aspeed,ast2600-i3c";
        reg = <0x1e7a5000 0x1000>;
        #address-cells = <3>;
        #size-cells = <0>;
        #interrupt-cells = <1>;
        clocks = <&syscon ASPEED_CLK_GATE_I3C3CLK>;
        resets = <&syscon ASPEED_RESET_I3C3>;
        interrupts = <GIC_SPI 105 IRQ_TYPE_LEVEL_HIGH>;
        status = "disabled";
    };
};

&pwm_tach {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_pwm0_default &pinctrl_pwm1_default
            &pinctrl_pwm2_default &pinctrl_pwm3_default
            &pinctrl_pwm4_default &pinctrl_pwm5_default
            &pinctrl_pwm6_default &pinctrl_pwm7_default
            &pinctrl_tach0_default &pinctrl_tach1_default
            &pinctrl_tach2_default &pinctrl_tach3_default
            &pinctrl_tach4_default &pinctrl_tach5_default
            &pinctrl_tach6_default &pinctrl_tach7_default
            &pinctrl_tach8_default &pinctrl_tach9_default
            &pinctrl_tach10_default &pinctrl_tach11_default
            &pinctrl_tach12_default &pinctrl_tach13_default
            &pinctrl_tach14_default &pinctrl_tach15_default>;

    fan-0 {
        tach-ch = /bits/ 8 <0x00 0x01>;
    };

    fan-1 {
        tach-ch = /bits/ 8 <0x02 0x03>;
    };

    fan-2 {
        tach-ch = /bits/ 8 <0x04 0x05>;
    };

    fan-3 {
        tach-ch = /bits/ 8 <0x06 0x07>;
    };

    fan-4 {
        tach-ch = /bits/ 8 <0x08 0x09>;
    };

    fan-5 {
        tach-ch = /bits/ 8 <0x0a 0x0b>;
    };

    fan-6 {
        tach-ch = /bits/ 8 <0x0c 0x0d>;
    };

    fan-7 {
        tach-ch = /bits/ 8 <0x0e 0x0f>;
    };
};

&fmc {
    status = "okay";

    /* BMC SPI Flash */
    flash@0 {
        label = "bmc";
        status = "okay";
        m25p,fast-read;
#include "openbmc-flash-layout-64.dtsi"
    };
};

&spi1 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_spi1_default>;

    /* Host SPI Flash */
    flash@0 {
        label = "pnor";
        status = "okay";
        m25p,fast-read;
    };
};

&mdio0 {
    status = "okay";

    ethphy0: ethernet-phy@0 {
        compatible = "ethernet-phy-ieee802.3-c22";
        reg = <0>;
    };
};

/* Dedicated NIC */
&mac2 {
    status = "okay";

    phy-mode = "rgmii-rxid";
    phy-handle = <&ethphy0>;

    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_rgmii3_default>;
};

/* NCSI NIC */
&mac3 {
    status = "okay";

    phy-mode = "rmii";

    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_rmii4_default>;

    use-ncsi;
};

/*
&espi {
    status = "okay";

    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_espi_default &pinctrl_espialt_default>;

    perif-dma-mode;
    oob-dma-mode;
    flash-dma-mode;
};
*/

/* RJ45 Serial Port on the back */
&uart1 {
    status = "okay";
    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_txd1_default
            &pinctrl_rxd1_default
            &pinctrl_ncts1_default
            &pinctrl_ndcd1_default
            &pinctrl_ndsr1_default
            &pinctrl_nri1_default
            &pinctrl_ndtr1_default
            &pinctrl_nrts1_default>;
};

/* Unclear at the moment */
&uart3 {
    status = "okay";
};

/* BMC 'DEBUG' UART */
&uart5 {
    status = "okay";
};

/* UART between BMC and CPU0 UART1 */
&uart9 {
    status = "okay";
};

&uart_routing {
    status = "okay";
};

/* Aux Panel Conn */
&i2c0 {
    status = "okay";
};

&i2c1 {
    status = "okay";

    i2c-mux@70 {
        compatible = "nxp,pca9548";
        reg = <0x70>;
        #address-cells = <1>;
        #size-cells = <0>;
        i2c-mux-idle-disconnect;

        BMC_SMB1: i2c@0 {
            #address-cells = <1>;
            #size-cells = <0>;
            reg = <0>;
        };

        BMC_SMB2: i2c@1 {
            #address-cells = <1>;
            #size-cells = <0>;
            reg = <1>;
        };

        BMC_SMB3: i2c@2 {
            #address-cells = <1>;
            #size-cells = <0>;
            reg = <2>;
        };

        MCIO5_1: i2c@4 {
            #address-cells = <1>;
            #size-cells = <0>;
            reg = <4>;
        };

        MCIO5_2: i2c@5 {
            #address-cells = <1>;
            #size-cells = <0>;
            reg = <5>;
        };

        MCIO6_1: i2c@6 {
            #address-cells = <1>;
            #size-cells = <0>;
            reg = <6>;
        };

        MCIO6_2: i2c@7 {
            #address-cells = <1>;
            #size-cells = <0>;
            reg = <7>;
        };
    };
};

/* APML Link to CPU0 */
&i2c2 {
    status = "okay";

    sbrmi@3c {
        compatible = "amd,sbrmi";
        reg = <0x3c>;
    };

    sbtsi@4c {
        compatible = "amd,sbtsi";
        reg = <0x4c>;
    };
};

/* APML Link to CPU1 */
&i2c3 {
    status = "okay";

    sbrmi@38 {
        compatible = "amd,sbrmi";
        reg = <0x38>;
    };

    sbtsi@48 {
        compatible = "amd,sbtsi";
        reg = <0x48>;
    };
};

/* SEC Link to CPU0 */
&i2c4 {
    status = "okay";

    /* 0x50 */
};

/* SEC Link to CPU1 */
&i2c5 {
    status = "okay";

    /* 0x51 */
};

&i2c6 {
    status = "okay";

    CPU0_SOC: vr@61 {
        compatible = "renesas,raa229001";
        reg = <0x61>;
    };

    CPU0_VDD11: vr@62 {
        compatible = "renesas,raa229001";
        reg = <0x62>;
    };

    CPU0_VDDIO: vr@63 {
        compatible = "renesas,raa229001";
        reg = <0x63>;
    };

    CPU1_SOC: vr@72 {
        compatible = "renesas,raa229001";
        reg = <0x72>;
    };

    CPU1_VDD11: vr@74 {
        compatible = "renesas,raa229001";
        reg = <0x74>;
    };

    CPU1_VDDIO: vr@75 {
        compatible = "renesas,raa229001";
        reg = <0x75>;
    };
};

&i2c7 {
    status = "okay";

    MB_FRU: eeprom@50 {
        compatible = "atmel,24c256";
        reg = <0x50>;
        pagesize = <64>;

        nvmem-layout {
            compatible = "fixed-layout";
            #address-cells = <1>;
            #size-cells = <1>;

            eth0_macaddress: macaddress@3f80 {
                reg = <0x3f80 6>;
            };

            usb0_host_macaddress: macaddress@3fd0 {
                reg = <0x3fd0 6>;
            };

            usb0_dev_macaddress: macaddress@3fd8 {
                reg = <0x3fd8 6>;
            };
        };
    };

    temperature-sensor@4c {
        compatible = "nuvoton,w83773g";
        reg = <0x4c>;
    };

    FAN_LED_CTRL: pca9557@1c {
        compatible = "nxp,pca9557";
        reg = <0x1c>;
        gpio-controller;
        #gpio-cells = <2>;

        /*
         * FAN1_LED_BIT: 0x04
         * FAN2_LED_BIT: 0x01
         * FAN3_LED_BIT: 0x08
         * FAN4_LED_BIT: 0x10
         * FAN5_LED_BIT: 0x02
         * FAN6_LED_BIT: 0x20
         * FAN7_LED_BIT: 0x40
         * FAN8_LED_BIT: 0x80
         */
    };
};

&i2c8 {
    status = "okay";
};

&i2c9 {
    status = "okay";

    /* LCMXO3LF-2100C CPLD 0x40 0x41 0x43 0x1C */
};

&i2c10 {
    status = "okay";

    i2c-mux@74 {
        compatible = "nxp,pca9548";
        reg = <0x74>;
        #address-cells = <1>;
        #size-cells = <0>;
        i2c-mux-idle-disconnect;

        PCIE_SLOT1: i2c@0 {
            #address-cells = <1>;
            #size-cells = <0>;
            reg = <0>;
        };

        PCIE_SLOT2: i2c@1 {
            #address-cells = <1>;
            #size-cells = <0>;
            reg = <1>;
        };

        PCIE_SLOT3: i2c@2 {
            #address-cells = <1>;
            #size-cells = <0>;
            reg = <2>;
        };

        M2_SLOT1: i2c@3 {
            #address-cells = <1>;
            #size-cells = <0>;
            reg = <3>;
        };

        MCIO8_1: i2c@4 {
            #address-cells = <1>;
            #size-cells = <0>;
            reg = <4>;
        };

        MCIO8_2: i2c@5 {
            #address-cells = <1>;
            #size-cells = <0>;
            reg = <5>;
        };

        M2_SLOT2: i2c@6 {
            #address-cells = <1>;
            #size-cells = <0>;
            reg = <6>;
        };

        OCP_SLOT1: i2c@7 {
            #address-cells = <1>;
            #size-cells = <0>;
            reg = <7>;
        };
    };
};

&i2c11 {
    status = "okay";

    /* i350 NIC */

    NIC_TEMP: temperature-sensor@4c {
        compatible = "nuvoton,w83773g";
        reg = <0x4c>;
    };
};

/* PSU Connection */
&i2c12 {
    status = "okay";

    /* PSU1 - ACBEL R1CA2202B */
    psu1@58 {
        compatible = "pmbus";
        reg = <0x58>;
    };

    /* PSU2 - ACBEL R1CA2202B */
    psu2@59 {
        compatible = "pmbus";
        reg = <0x59>;
    };

    /* PSU1 EEPROM */
    eeprom@50 {
        compatible = "atmel,24c02";
        reg = <0x50>;
    };

    /* PSU2 EEPROM */
    eeprom@51 {
        compatible = "atmel,24c02";
        reg = <0x51>;
    };
};

/*
 * I3C Controllers for DDR5 DIMM SPD/Temperature Sensors
 * - 24 DIMMs total across 4 I3C buses
 * - Each DIMM has SPD5118 device (0x50) with integrated temperature sensor
 * - I2C mode at 100 kHz for compatibility, I3C mode at 2 MHz
 */

&i3c0 {
	status = "okay";
	aspeed,global-regs = <&i3c_global 0>;
	i2c-scl-hz = <100000>;
	i3c-scl-hz = <2000000>;
	sda-pullup-ohms = <2000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i3c1_default>;

	/* CPU0 DIMM channels A-F (6 DIMMs) */
	/* Explicitly define SPD5118 devices as I2C devices on I3C bus */
	spd5118@50 {
		compatible = "jedec,spd5118";
		reg = <0x50 0x0 0x0>;  /* I2C address 0x50 */
	};

	spd5118@51 {
		compatible = "jedec,spd5118";
		reg = <0x51 0x0 0x0>;  /* I2C address 0x51 */
	};

	spd5118@52 {
		compatible = "jedec,spd5118";
		reg = <0x52 0x0 0x0>;
	};

	spd5118@53 {
		compatible = "jedec,spd5118";
		reg = <0x53 0x0 0x0>;
	};

	spd5118@54 {
		compatible = "jedec,spd5118";
		reg = <0x54 0x0 0x0>;
	};

	spd5118@55 {
		compatible = "jedec,spd5118";
		reg = <0x55 0x0 0x0>;
	};
};

&i3c1 {
	status = "okay";
	aspeed,global-regs = <&i3c_global 1>;
	i2c-scl-hz = <100000>;
	i3c-scl-hz = <2000000>;
	sda-pullup-ohms = <2000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i3c2_default>;

	/* CPU0 DIMM channels G-L (6 DIMMs) */
	spd5118@50 {
		compatible = "jedec,spd5118";
		reg = <0x50 0x0 0x0>;
	};

	spd5118@51 {
		compatible = "jedec,spd5118";
		reg = <0x51 0x0 0x0>;
	};

	spd5118@52 {
		compatible = "jedec,spd5118";
		reg = <0x52 0x0 0x0>;
	};

	spd5118@53 {
		compatible = "jedec,spd5118";
		reg = <0x53 0x0 0x0>;
	};

	spd5118@54 {
		compatible = "jedec,spd5118";
		reg = <0x54 0x0 0x0>;
	};

	spd5118@55 {
		compatible = "jedec,spd5118";
		reg = <0x55 0x0 0x0>;
	};
};

&i3c2 {
	status = "okay";
	aspeed,global-regs = <&i3c_global 2>;
	i2c-scl-hz = <100000>;
	i3c-scl-hz = <2000000>;
	sda-pullup-ohms = <2000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i3c3_default>;

	/* CPU1 DIMM channels A-F (6 DIMMs) */
	spd5118@50 {
		compatible = "jedec,spd5118";
		reg = <0x50 0x0 0x0>;
	};

	spd5118@51 {
		compatible = "jedec,spd5118";
		reg = <0x51 0x0 0x0>;
	};

	spd5118@52 {
		compatible = "jedec,spd5118";
		reg = <0x52 0x0 0x0>;
	};

	spd5118@53 {
		compatible = "jedec,spd5118";
		reg = <0x53 0x0 0x0>;
	};

	spd5118@54 {
		compatible = "jedec,spd5118";
		reg = <0x54 0x0 0x0>;
	};

	spd5118@55 {
		compatible = "jedec,spd5118";
		reg = <0x55 0x0 0x0>;
	};
};

&i3c3 {
	status = "okay";
	aspeed,global-regs = <&i3c_global 3>;
	i2c-scl-hz = <100000>;
	i3c-scl-hz = <2000000>;
	sda-pullup-ohms = <2000>;
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_i3c4_default>;

	/* CPU1 DIMM channels G-L (6 DIMMs) */
	spd5118@50 {
		compatible = "jedec,spd5118";
		reg = <0x50 0x0 0x0>;
	};

	spd5118@51 {
		compatible = "jedec,spd5118";
		reg = <0x51 0x0 0x0>;
	};

	spd5118@52 {
		compatible = "jedec,spd5118";
		reg = <0x52 0x0 0x0>;
	};

	spd5118@53 {
		compatible = "jedec,spd5118";
		reg = <0x53 0x0 0x0>;
	};

	spd5118@54 {
		compatible = "jedec,spd5118";
		reg = <0x54 0x0 0x0>;
	};

	spd5118@55 {
		compatible = "jedec,spd5118";
		reg = <0x55 0x0 0x0>;
	};
};

&gfx {
    status = "okay";
    memory-region = <&gfx_memory>;
};

&video {
    status = "okay";
    memory-region = <&video_engine_memory>;
};

&vhub {
    status = "okay";
};

/* For AMD HDT (YAAP) */
/*
&jtag1 {
    status = "okay";
};
*/

&adc0 {
    aspeed,int-vref-microvolt = <2500000>;
    status = "okay";

    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_adc0_default
        &pinctrl_adc1_default
        &pinctrl_adc2_default
        &pinctrl_adc3_default
        &pinctrl_adc4_default
        &pinctrl_adc5_default
        &pinctrl_adc6_default
        &pinctrl_adc7_default>;
};

&adc1 {
    aspeed,int-vref-microvolt = <2500000>;
    status = "okay";

    pinctrl-names = "default";
    pinctrl-0 = <&pinctrl_adc8_default
        &pinctrl_adc9_default
        &pinctrl_adc10_default
        &pinctrl_adc11_default
        &pinctrl_adc12_default
        &pinctrl_adc13_default
        &pinctrl_adc14_default
        &pinctrl_adc15_default>;
};

&kcs3 {
    status = "okay";
    aspeed,lpc-io-reg = <0xca2>;
};

&lpc_ctrl {
    status = "okay";
};

&lpc_snoop {
    status = "okay";
    snoop-ports = <0x80>;
};

&hace {
    status = "okay";
};

&acry {
    status = "okay";
};

