/*
 * GPIO Passthrough configuration - DISABLED
 * The AST2600 pinctrl driver doesn't support "gpio" or "passthrough" functions
 * in the way we tried to use them. Need to research correct function names.
 *
&pinctrl {
    pinctrl_gpiop2p3_passthrough: gpiop2p3-passthrough {
        groups = "GPIOP2", "GPIOP3";
        function = "passthrough";
    };

    pinctrl_gpiop2p3_gpio: gpiop2p3-gpio {
        groups = "GPIOP2", "GPIOP3";
        function = "gpio";
    };

    pinctrl_gpiop0p1_passthrough: gpiop0p1-passthrough {
        groups = "GPIOP0", "GPIOP1";
        function = "passthrough";
    };

    pinctrl_gpiop0p1_gpio: gpiop0p1-gpio {
        groups = "GPIOP0", "GPIOP1";
        function = "gpio";
    };

    pinctrl_gpiop4p5_passthrough: gpiop4p5-passthrough {
        groups = "GPIOP4", "GPIOP5";
        function = "passthrough";
    };

    pinctrl_gpiop4p5_gpio: gpiop4p5-gpio {
        groups = "GPIOP4", "GPIOP5";
        function = "gpio";
    };
};
*/
