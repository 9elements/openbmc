From aa98ce0f66e033ae5443649c2ec434966c2558de Mon Sep 17 00:00:00 2001
From: Naresh Solanki <naresh.solanki@9elements.com>
Date: Thu, 19 Mar 2026 14:09:10 +0000
Subject: [PATCH 6/9] ibm: system1: Add CPU temperature sensors to PID loop

Ensure that the CPUs don't overheat by adding them to the PID loop.

Upstream-Status: Pending
Change-Id: Ic4c4c10ab3fea5cd53c2f58805a1134b0d72a42f
Signed-off-by: Patrick Rudolph <patrick.rudolph@9elements.com>


---
 configurations/system1_baseboard.json | 27 +++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/configurations/system1_baseboard.json b/configurations/system1_baseboard.json
index 4a91bf220..43aebe8a4 100644
--- a/configurations/system1_baseboard.json
+++ b/configurations/system1_baseboard.json
@@ -592,6 +592,33 @@
                 "CECIO"
             ]
         },
+        {
+            "Class": "temp",
+            "FFGainCoefficient": 0,
+            "FFOffCoefficient": 0,
+            "ICoefficient": -5,
+            "ILimitMax": 18000,
+            "ILimitMin": 2500,
+            "InputUnavailableAsFailed": false,
+            "Inputs": [
+                "Die_CPU0",
+                "Die_CPU1"
+            ],
+            "Name": "CPU Temperature",
+            "NegativeHysteresis": 0,
+            "OutLimitMax": 18000,
+            "OutLimitMin": 2500,
+            "Outputs": [],
+            "PCoefficient": -500,
+            "PositiveHysteresis": 0,
+            "SetPoint": 85,
+            "SlewNeg": 0,
+            "SlewPos": 0,
+            "Type": "Pid",
+            "Zones": [
+                "CECIO"
+            ]
+        },
         {
             "Address": "0x4c",
             "Bus": 70,
-- 
