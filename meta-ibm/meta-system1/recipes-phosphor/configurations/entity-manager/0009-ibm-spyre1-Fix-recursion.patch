+              "OR",
+              "xyz.openbmc_project.Inventory.Decorator.I2CDevice({'Address': 81, 'Bus': 82})",
+              "OR",
+              "xyz.openbmc_project.Inventory.Decorator.I2CDevice({'Address': 81, 'Bus': 83})",
