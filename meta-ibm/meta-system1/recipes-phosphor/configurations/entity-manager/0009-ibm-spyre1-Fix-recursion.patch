+              "xyz.openbmc_project.Inventory.Decorator.I2CDevice({'Address': 81, 'Bus': 84})",
+              "OR",
+              "xyz.openbmc_project.Inventory.Decorator.I2CDevice({'Address': 81, 'Bus': 85})",
+              "OR",
+              "xyz.openbmc_project.Inventory.Decorator.I2CDevice({'Address': 81, 'Bus': 86})",
+              "OR",
+              "xyz.openbmc_project.Inventory.Decorator.I2CDevice({'Address': 81, 'Bus': 87})"],
     "Type": "Board",
     "xyz.openbmc_project.Inventory.Decorator.Asset": {
         "Manufacturer": "$Manufacturer",
